# Copy to .env.production and keep it private.

# HTTP listener published by the production container.
APP_BIND_ADDR=127.0.0.1
APP_PORT=8080

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters
DATABASE_URL=postgres://streamweave:replace-with-64-hex-characters@postgres:5432/streamweave?sslmode=disable

# Exactly 32 random bytes encoded as 64 hex characters.
# Generate with: openssl rand -hex 32
MASTER_KEY=replace-with-64-hex-characters

# Generate with: openssl rand -base64 48
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional. Change these together if the default backend subnet conflicts on your host.
BACKEND_SUBNET=10.199.17.0/24
POSTGRES_IP=10.199.17.10
MIGRATE_IP=10.199.17.11
APP_IP=10.199.17.20
