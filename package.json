{
  "name": "media-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "api:generate": "tsp compile api/typespec --output-dir api/openapi",
    "api:check": "bun run api:generate && git diff --exit-code -- api/openapi",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:lint": "cd web && bun run lint",
    "web:types": "bunx openapi-typescript@latest api/openapi/openapi.yaml -o web/src/api/schema.d.ts"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi3": "^1.16.0"
  }
}
